parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    paths:
        - ./
    excludePaths:
        - %rootDir%/../../../tests/*
        - %rootDir%/../../../vendor/*
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        - '#Method Zend_Acl::_roleDFSAllPrivileges\(\) invoked with 3 parameters, 1-2 required\.#'
